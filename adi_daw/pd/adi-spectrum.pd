#N canvas 0 50 1000 760 12;
#X text 20 10 adi-spectrum -- the analyser DSP tier (ADR-0183 \, ADR-0195 d5). Generated: do not edit by hand.;
#X text 20 40 NO dac~. An analyser hears and does not speak (ADR-0183): the patch has nothing to write to \, so it cannot touch the audio even by mistake.;
#X obj 20 90 adc~ 1 2;
#X obj 20 140 +~;
#X obj 20 180 *~ 0.5;
#X text 520 90 The window \, built once at load. cosinesum is periodic (2pi/n) \, which is what dsp::fillWindow does \; it resizes to n+3 for Pd's guard points.;
#X obj 520 150 table \$0-window 1024;
#X obj 520 190 loadbang;
#X msg 520 230 cosinesum 1024 0.5 -0.5;
#X obj 520 270 s \$0-window;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X obj 520 330 adi.array \$0 1 513 30 -120 0 dB Spectrum;
#N canvas 0 50 450 300 analysis 0;
#X obj 20 20 block~ 1024 4;
#X obj 20 60 inlet~;
#X obj 160 60 tabreceive~ \$0-window;
#X obj 20 100 *~;
#X obj 20 140 rfft~;
#X obj 20 190 expr~ 20*log10(max(sqrt($v1*$v1 + $v2*$v2) * 0.00390625 \, 0.000000001));
#X obj 20 240 clip~ -120 0;
#X obj 300 190 bang~;
#X obj 20 290 tabwrite~ \$0-adiarr-1;
#X connect 1 0 3 0;
#X connect 2 0 3 1;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 1 5 1;
#X connect 5 0 6 0;
#X connect 6 0 8 0;
#X connect 7 0 8 0;
#X restore 20 240 pd analysis;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X connect 3 0 4 0;
#X connect 4 0 11 0;
