#N canvas 0 50 760 560 12;
#X text 20 10 adi.transport -- the host's transport (ADR-0188 d3). Licence MIT \, like adi.param and adi.array.;
#X text 20 60 [adi.transport \$0];
#X text 20 100 Seven outlets \, left to right: playing (0 or 1) \, BPM \, time signature numerator \, time signature denominator \, bar \, beat \, and ticks on the QUARTER-NOTE GRID.;
#X text 20 150 THE LAST ONE IS NOT THE POSITION WITHIN THE BEAT \, and in 5/8 or 7/8 those are different numbers. It is the absolute tick count modulo 5765760 -- the quarter-note grid counted from bar 1 -- so it runs 0 to 5765759 and wraps every quarter note whatever the meter says a beat is. In 7/8 the beat is an eighth \, and this outlet wraps once per TWO of them. Use bar and beat for the meter \; use this for a quarter-note phase.;
#X text 20 250 NO ABSOLUTE TICK COUNT \, and that is the point of the last two. Pd's numbers are 32-bit floats \, exact for integers only to 2^24 = 16777216 \, and ADI's 5765760 ticks per quarter note pass that within three quarter notes. Bar \, beat and ticks-within-the-quarter are each small enough to be exact for as long as anyone plays.;
#X text 20 370 IN VANILLA PD nothing sends to the receive name \, so the outlets never fire and a patch that needs transport simply does not move. IN THE DAW the host sends one list per segment \, before the audio it belongs to.;
#X obj 20 400 r \$1-aditr;
#X obj 20 440 unpack f f f f f f f;
#X obj 20 500 outlet;
#X obj 110 500 outlet;
#X obj 200 500 outlet;
#X obj 290 500 outlet;
#X obj 380 500 outlet;
#X obj 470 500 outlet;
#X obj 560 500 outlet;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 9 0;
#X connect 7 2 10 0;
#X connect 7 3 11 0;
#X connect 7 4 12 0;
#X connect 7 5 13 0;
#X connect 7 6 14 0;
