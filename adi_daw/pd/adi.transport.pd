#N canvas 0 50 760 560 12;
#X text 20 10 adi.transport -- the host's transport (ADR-0188 d3). Licence MIT \, like adi.param and adi.array.;
#X text 20 60 [adi.transport \$0];
#X text 20 100 Seven outlets \, left to right: playing (0 or 1) \, BPM \, time signature numerator \, time signature denominator \, bar \, beat \, and ticks within the quarter note.;
#X text 20 180 NO ABSOLUTE TICK COUNT \, and that is the point of the last two. Pd's numbers are 32-bit floats \, exact for integers only to 2^24 = 16777216 \, and ADI's 5765760 ticks per quarter note pass that within three quarter notes. Bar \, beat and ticks-within-the-quarter are each small enough to be exact for as long as anyone plays.;
#X text 20 300 IN VANILLA PD nothing sends to the receive name \, so the outlets never fire and a patch that needs transport simply does not move. IN THE DAW the host sends one list per segment \, before the audio it belongs to.;
#X obj 20 400 r \$1-aditr;
#X obj 20 440 unpack f f f f f f f;
#X obj 20 500 outlet;
#X obj 110 500 outlet;
#X obj 200 500 outlet;
#X obj 290 500 outlet;
#X obj 380 500 outlet;
#X obj 470 500 outlet;
#X obj 560 500 outlet;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 1 8 0;
#X connect 6 2 9 0;
#X connect 6 3 10 0;
#X connect 6 4 11 0;
#X connect 6 5 12 0;
#X connect 6 6 13 0;
