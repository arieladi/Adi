#N canvas 0 50 760 560 12;
#X text 20 10 ADI instrument -- a starting point (DEV-10). Notes arrive at [notein] and the sound leaves through [dac~ 1 2]. This one is a single sine voice: [poly 1 1] keeps the last note and turns off the one it replaces. Each [adi.param] box is a parameter the host shows \, automates and saves.;
#X obj 20 110 notein;
#X obj 20 150 poly 1 1;
#X obj 20 180 pack f f f;
#X obj 20 210 route 1;
#X obj 20 240 t l l;
#X obj 200 270 unpack f f;
#X obj 200 300 mtof;
#X obj 200 330 osc~;
#X obj 20 270 unpack f f;
#X obj 80 300 sel 0;
#X obj 120 330 / 127;
#X obj 120 360 list append 5;
#X obj 20 330 f;
#X obj 20 360 list prepend 0;
#X obj 20 400 vline~;
#X obj 200 430 *~;
#X obj 200 460 *~ 0.25;
#X obj 200 500 dac~ 1 2;
#X obj 420 300 adi.param \$0 1 1 5000 200 ms 3 Release;
#X text 420 340 Note on: rise to the velocity in 5 ms. Note off: fall to 0 over Release.;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X connect 2 2 3 2;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 5 0 9 0;
#X connect 9 1 10 0;
#X connect 10 0 13 0;
#X connect 10 1 11 0;
#X connect 11 0 12 0;
#X connect 12 0 15 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 19 0 13 1;
#X connect 8 0 16 0;
#X connect 15 0 16 1;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 17 0 18 1;
