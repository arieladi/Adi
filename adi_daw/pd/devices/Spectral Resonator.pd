#N canvas 0 0 1100 900 12;
#X obj 20 20 adc~ 1 2;
#X obj 20 100 adi.spectral_resonator~;
#X obj 20 180 dac~ 1 2;
#X obj 300 20 adi.param \$0 1 20 5000 220 Hz log Frequency;
#X msg 300 60 p 0 \$1;
#X obj 300 90 adi.param \$0 2 1 64 16 - int Harmonics;
#X msg 300 130 p 1 \$1;
#X obj 300 160 adi.param \$0 3 -100 100 0 % lin Stretch;
#X msg 300 200 p 2 \$1;
#X obj 300 230 adi.param \$0 4 20 20000 2000 ms log Decay;
#X msg 300 270 p 3 \$1;
#X obj 300 300 adi.param \$0 5 -100 100 0 % lin Brightness;
#X msg 300 340 p 4 \$1;
#X obj 300 370 adi.param \$0 6 0 100 50 % lin Dry/Wet;
#X msg 300 410 p 5 \$1;
#X obj 20 260 r \$0-query_latency;
#X msg 20 300 latency;
#X obj 20 340 s \$0-report_latency;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 3 0 4 0;
#X connect 4 0 1 0;
#X connect 5 0 6 0;
#X connect 6 0 1 0;
#X connect 7 0 8 0;
#X connect 8 0 1 0;
#X connect 9 0 10 0;
#X connect 10 0 1 0;
#X connect 11 0 12 0;
#X connect 12 0 1 0;
#X connect 13 0 14 0;
#X connect 14 0 1 0;
#X connect 15 0 16 0;
#X connect 16 0 1 0;
