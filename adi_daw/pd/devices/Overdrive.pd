#X msg 300 60 p 0 \$1;
#X obj 300 120 adi.param \$0 2 .1 6 3 oct log Bandwidth;
#X msg 300 160 p 1 \$1;
#X obj 300 220 adi.param \$0 3 0 100 50 % lin Drive;
#X msg 300 260 p 2 \$1;
#X obj 300 320 adi.param \$0 4 0 100 50 % lin Tone;
#X msg 300 360 p 3 \$1;
#X obj 300 420 adi.param \$0 5 0 100 50 % lin Dynamics;
#X msg 300 460 p 4 \$1;
#X obj 300 520 adi.param \$0 6 0 100 100 % lin Mix;
#X msg 300 560 p 5 \$1;
#X obj 20 260 r \$0-query_latency;
#X msg 20 300 latency;
#X obj 20 340 s \$0-report_latency;
