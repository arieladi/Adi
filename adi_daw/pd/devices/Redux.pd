#N canvas 0 0 1000 800 12;
#X obj 20 20 adc~ 1 2;
#X obj 20 100 adi.redux~;
#X obj 20 180 dac~ 1 2;
#X obj 300 20 adi.param \$0 1 20 48000 48000 Hz log Rate;
#X msg 300 60 rate \$1;
#X obj 300 160 adi.param \$0 2 0 100 0 % lin Jitter;
#X msg 300 200 jitter \$1;
#X obj 300 300 adi.param \$0 3 1 24 16 bits lin Bits;
#X msg 300 340 bits \$1;
#X obj 300 440 adi.param \$0 4 0 100 0 % lin Shape;
#X msg 300 480 shape \$1;
#X obj 300 580 adi.param \$0 5 0 1 0 - int Pre;
#X msg 300 620 pre \$1;
#X obj 630 20 adi.param \$0 6 0 1 0 - int Post;
#X msg 630 60 post \$1;
#X obj 630 160 adi.param \$0 7 -4 4 0 oct lin Post-Filter_Octave;
#X msg 630 200 octave \$1;
#X obj 630 300 adi.param \$0 8 0 1 0 - int DC_Shift;
#X msg 630 340 dc \$1;
#X obj 630 440 adi.param \$0 9 0 100 100 % lin Dry/Wet;
#X msg 630 480 mix \$1;
#X obj 20 260 r \$0-query_latency;
#X msg 20 300 0;
#X obj 20 340 s \$0-report_latency;
