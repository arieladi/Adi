#N canvas 0 0 1100 900 12;
#X obj 20 20 adc~ 1 2;
#X obj 20 100 adi.vinyl_distortion~;
#X obj 20 180 dac~ 1 2;
#X obj 300 20 adi.param \$0 1 0 1 1 - toggle Tracing_On;
#X msg 300 60 p 0 \$1;
#X obj 300 90 adi.param \$0 2 0 1 0.2 - lin Tracing_Drive;
#X msg 300 130 p 1 \$1;
#X obj 300 160 adi.param \$0 3 50 18000 1000 Hz log Tracing_Freq;
#X msg 300 200 p 2 \$1;
#X obj 300 230 adi.param \$0 4 0.1 10 1 - log Tracing_Width;
#X msg 300 270 p 3 \$1;
#X obj 300 300 adi.param \$0 5 0 1 0 - toggle Pinch_On;
#X msg 300 340 p 4 \$1;
#X obj 300 370 adi.param \$0 6 0 1 0.2 - lin Pinch_Drive;
#X msg 300 410 p 5 \$1;
#X obj 300 440 adi.param \$0 7 50 18000 3000 Hz log Pinch_Freq;
#X msg 300 480 p 6 \$1;
#X obj 300 510 adi.param \$0 8 0.1 10 1 - log Pinch_Width;
#X msg 300 550 p 7 \$1;
#X obj 300 580 adi.param \$0 9 0 1 0 - menu Soft Hard Soft;
#X msg 300 620 p 8 \$1;
#X obj 300 650 adi.param \$0 10 0 1 1 - menu Stereo Mono Stereo;
#X msg 300 690 p 9 \$1;
#X obj 300 720 adi.param \$0 11 -70 0 -70 dB lin Crackle_Volume;
#X msg 300 760 p 10 \$1;
#X obj 300 790 adi.param \$0 12 0 50 10 /s lin Crackle_Density;
#X msg 300 830 p 11 \$1;
#X obj 20 260 r \$0-query_latency;
#X msg 20 300 latency;
#X obj 20 340 s \$0-report_latency;
