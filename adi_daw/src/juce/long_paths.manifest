<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SC-388: ADI reads and writes files at paths over 260 characters (a sample deep in a library), where
     Windows allows long paths (LongPathsEnabled, on by default since Windows 10 1607 setups that ask for it).
     Merged by the linker with the program's other manifest entries. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
