#N canvas 0 50 620 460 12;
#X text 20 10 adi-proof -- the libpd runtime's own test fixture (ADR-0183). NOT a device: a TOP-LEVEL patch with adc~/dac~ \, because that is what libpd renders. The patches in pd/ are abstractions and libpd cannot render one directly.;
#X obj 20 90 adc~ 1 2;
#X obj 20 140 *~ 1;
#X obj 140 140 *~ 1;
#X obj 20 200 dac~ 1 2;
#X obj 260 90 r \$0-gain;
#X obj 380 90 r \$0-query_latency;
#X obj 380 140 f 64;
#X obj 380 260 s \$0-report_latency;
#X obj 500 90 loadbang;
#X obj 500 140 f 99;
#X text 500 180 the WRONG early value \, at Pd's default rate;
#X connect 1 0 2 0;
#X connect 1 1 3 0;
#X connect 5 0 2 1;
#X connect 5 0 3 1;
#X connect 2 0 4 0;
#X connect 3 0 4 1;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 9 0 10 0;
#X connect 10 0 8 0;
