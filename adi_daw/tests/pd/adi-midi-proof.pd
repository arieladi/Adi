#N canvas 0 50 760 620 12;
#X text 20 10 adi-midi-proof -- MIDI into a Pd device (ADR-0194). Each of the three objects the brief names writes what it received into a published array \, so the test reads back what actually arrived rather than trusting that it did.;
#X obj 20 470 adc~ 1 2;
#X obj 20 520 dac~ 1 2;
#X obj 20 90 notein;
#X obj 220 90 ctlin;
#X obj 440 90 bendin;
#X obj 600 470 adi.array \$0 1 8 200 -16384 16384 - Midi;
#X obj 20 150 list prepend 0;
#X obj 20 190 list trim;
#X obj 20 230 s \$0-adiarr-1;
#X obj 120 150 list prepend 1;
#X obj 120 190 list trim;
#X obj 120 230 s \$0-adiarr-1;
#X obj 220 290 list prepend 2;
#X obj 220 330 list trim;
#X obj 220 370 s \$0-adiarr-1;
#X obj 350 290 list prepend 3;
#X obj 350 330 list trim;
#X obj 350 370 s \$0-adiarr-1;
#X obj 440 150 list prepend 4;
#X obj 440 190 list trim;
#X obj 440 230 s \$0-adiarr-1;
#X text 600 520 cell 0 pitch \, 1 velocity \, 2 controller \, 3 controller value \, 4 bend (0..16383 \, 8192 centred).;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 3 0 7 0;
#X connect 3 1 10 0;
#X connect 4 1 13 0;
#X connect 4 0 16 0;
#X connect 5 0 19 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 19 0 20 0;
#X connect 20 0 21 0;
