#N canvas 0 50 860 560 12;
#X text 20 10 adi-position-log -- each Pd tick's exact position from [adi.transport] \, in order: cell n of array 1 holds the nth tick's whole quarter notes \, of array 3 its fraction \, and cell 0 of array 2 how many came.;
#X obj 20 480 adc~ 1 2;
#X obj 20 520 dac~ 1 2;
#X obj 20 60 adi.transport \$0;
#X obj 20 110 t b f;
#X obj 20 160 f;
#X obj 70 160 + 1;
#X obj 20 260 pack f f;
#X obj 20 300 list trim;
#X obj 20 340 s \$0-adiarr-1;
#X obj 450 400 adi.array \$0 1 3072 1000 -1000000 20000000 - Wholes;
#X obj 450 440 adi.array \$0 2 1 1000 0 100000 - Count;
#X obj 200 210 list prepend 0;
#X obj 200 250 list trim;
#X obj 200 290 s \$0-adiarr-2;
#X obj 20 210 t f f;
#X obj 350 260 pack f f;
#X obj 350 300 list trim;
#X obj 350 340 s \$0-adiarr-3;
#X obj 450 480 adi.array \$0 3 3072 1000 -1 2 - Fractions;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 3 7 4 0;
#X connect 3 8 16 1;
#X connect 4 1 7 1;
#X connect 4 0 5 0;
#X connect 5 0 15 0;
#X connect 5 0 6 0;
#X connect 15 1 16 0;
#X connect 15 0 7 0;
#X connect 6 0 5 1;
#X connect 6 0 12 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
