add_library(adi_stereo_envelope_meter STATIC src/adi/dsp/stereo_envelope_meter.cpp)
target_include_directories(adi_stereo_envelope_meter PUBLIC src)
target_compile_features(adi_stereo_envelope_meter PUBLIC cxx_std_20)
target_link_libraries(adi_stereo_envelope_meter PRIVATE adi_warnings)
target_link_libraries(adi_core PRIVATE adi_stereo_envelope_meter)
set_target_properties(adi_stereo_envelope_meter PROPERTIES POSITION_INDEPENDENT_CODE ON INTERPROCEDURAL_OPTIMIZATION FALSE)
if(MSVC)
    target_compile_options(adi_stereo_envelope_meter PRIVATE /fp:precise)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        target_compile_options(adi_stereo_envelope_meter PRIVATE /clang:-ffp-contract=off /clang:-fno-lto)
    else()
        target_compile_options(adi_stereo_envelope_meter PRIVATE /GL-)
    endif()
else()
    target_compile_options(adi_stereo_envelope_meter PRIVATE -fno-fast-math -ffp-contract=off -fno-lto)
endif()
add_executable(adi_stereo_envelope_meter_tests tests/test_stereo_envelope_meter.cpp)
target_link_libraries(adi_stereo_envelope_meter_tests PRIVATE adi_stereo_envelope_meter adi_warnings)
add_test(NAME adi_stereo_envelope_meter_tests COMMAND adi_stereo_envelope_meter_tests)
