# Framework-free continuous acquisition; not linked into the audio graph/UI.
add_library(adi_triggered_scope STATIC src/adi/dsp/triggered_scope.cpp)
target_include_directories(adi_triggered_scope PUBLIC src)
target_compile_features(adi_triggered_scope PUBLIC cxx_std_20)
target_link_libraries(adi_triggered_scope PRIVATE adi_warnings)
set_target_properties(adi_triggered_scope PROPERTIES POSITION_INDEPENDENT_CODE ON INTERPROCEDURAL_OPTIMIZATION FALSE)
if(MSVC)
    target_compile_options(adi_triggered_scope PRIVATE /fp:precise)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        target_compile_options(adi_triggered_scope PRIVATE /clang:-ffp-model=precise /clang:-ffp-contract=off /clang:-fno-lto)
    else()
        target_compile_options(adi_triggered_scope PRIVATE /GL-)
    endif()
    set_property(SOURCE tests/test_triggered_scope.cpp APPEND PROPERTY COMPILE_OPTIONS /fp:precise)
    set_property(SOURCE tests/test_triggered_scope_fast.cpp APPEND PROPERTY COMPILE_OPTIONS /fp:fast)
else()
    target_compile_options(adi_triggered_scope PRIVATE -fno-fast-math -ffp-contract=off -fno-lto)
    set_property(SOURCE tests/test_triggered_scope.cpp APPEND PROPERTY COMPILE_OPTIONS -fno-fast-math -ffp-contract=off)
    set_property(SOURCE tests/test_triggered_scope_fast.cpp APPEND PROPERTY COMPILE_OPTIONS -ffast-math)
endif()
add_executable(adi_ui_triggered_scope_tests tests/test_triggered_scope.cpp tests/test_triggered_scope_fast.cpp)
target_link_libraries(adi_ui_triggered_scope_tests PRIVATE adi_triggered_scope adi_warnings)
set_target_properties(adi_ui_triggered_scope_tests PROPERTIES INTERPROCEDURAL_OPTIMIZATION FALSE)
add_test(NAME adi_ui_triggered_scope_tests COMMAND adi_ui_triggered_scope_tests)
