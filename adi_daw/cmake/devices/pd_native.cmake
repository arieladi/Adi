if(ADI_WITH_PD)
    # Keep the native allowlist tied to the exact canvases shipped by this
    # build. Updating a canvas or its abstractions regenerates the header.
    set(ADI_NATIVE_PD_HEADER "// Generated by cmake/devices/pd_native.cmake.\n#pragma once\n#include <string_view>\nnamespace adi::device::canonical {\n")
    function(adi_embed_native_pd identifier relative_path)
        set(path "${CMAKE_CURRENT_SOURCE_DIR}/${relative_path}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" patch_text)
        string(FIND "${patch_text}" ")ADI_PD_CANON\"" delimiter_position)
        if(NOT delimiter_position EQUAL -1)
            message(FATAL_ERROR "Raw string delimiter appears in ${relative_path}")
        endif()
        string(APPEND ADI_NATIVE_PD_HEADER
            "inline constexpr std::string_view ${identifier} = R\"ADI_PD_CANON(${patch_text})ADI_PD_CANON\";\n")
        set(ADI_NATIVE_PD_HEADER "${ADI_NATIVE_PD_HEADER}" PARENT_SCOPE)
    endfunction()
    adi_embed_native_pd(autoFilter "pd/devices/AutoFilter.pd")
    adi_embed_native_pd(chordComb "pd/devices/Chord Comb.pd")
    adi_embed_native_pd(chorusEnsemble "pd/devices/Chorus-Ensemble.pd")
    adi_embed_native_pd(colorCab "pd/devices/Color Cab.pd")
    adi_embed_native_pd(delay "pd/devices/Delay.pd")
    adi_embed_native_pd(eqEight "pd/devices/EQEight.pd")
    adi_embed_native_pd(echo "pd/devices/Echo.pd")
    adi_embed_native_pd(multibandDynamics "pd/devices/MultibandDynamics.pd")
    adi_embed_native_pd(overdrive "pd/devices/Overdrive.pd")
    adi_embed_native_pd(phaserFlanger "pd/devices/Phaser-Flanger.pd")
    adi_embed_native_pd(redux "pd/devices/Redux.pd")
    adi_embed_native_pd(resonators "pd/devices/Resonators.pd")
    adi_embed_native_pd(reverb "pd/devices/Reverb.pd")
    adi_embed_native_pd(saturator "pd/devices/Saturator.pd")
    adi_embed_native_pd(shifter "pd/devices/Shifter.pd")
    adi_embed_native_pd(utility "pd/devices/Utility.pd")
    adi_embed_native_pd(vocoder "pd/devices/Vocoder.pd")
    adi_embed_native_pd(paramAbstraction "pd/adi.param.pd")
    adi_embed_native_pd(transportAbstraction "pd/adi.transport.pd")
    adi_embed_native_pd(sampleAbstraction "pd/devices/adi.sample.pd")
    string(APPEND ADI_NATIVE_PD_HEADER "} // namespace adi::device::canonical\n")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/adi_native_pd_patches.hpp"
        CONTENT "${ADI_NATIVE_PD_HEADER}")
    target_sources(adi_core PRIVATE src/adi/pd_builtins/native_devices.cpp)
    target_include_directories(adi_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
    add_executable(adi_pd_native_devices_tests tests/test_pd_native_devices.cpp)
    target_link_libraries(adi_pd_native_devices_tests PRIVATE adi_core adi_warnings)
    target_compile_definitions(adi_pd_native_devices_tests PRIVATE
        ADI_PD_PATCH_DIR="${CMAKE_CURRENT_SOURCE_DIR}/pd"
        ADI_DEVICE_PATCH_DIR="${CMAKE_CURRENT_SOURCE_DIR}/pd/devices")
    add_test(NAME adi_pd_native_devices_tests COMMAND adi_pd_native_devices_tests)
endif()
