# Normalize all text files to LF so Windows checkouts don't introduce CRLF
* text=auto eol=lf

# PowerShell installers must be CRLF for older Windows hosts
*.ps1 text eol=crlf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.node binary
*.streamDeckProfile binary
*.streamDeckPlugin binary
