# Ignore macOS Finder metadata files
.DS_Store

# Wrangler local state and cache
.wrangler/

# Local-only secrets for wrangler dev.
# No leading slash and no directory part, so this matches at EVERY depth —
# finance/.dev.vars is covered, not just a file at the repo root. The starred form
# catches wrangler's per-environment variants (.dev.vars.production, .dev.vars.local).
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# Belt and braces: never commit a raw env file from any tool.
.env
.env.*
!.env.example

# D1 exports contain personal financial data
finance/.backup-*.sql

# npm deps (wrangler bundles them at deploy time)
node_modules/

# adi-vst/vital is its own git repo: a fork of mtytel/vital with an `upstream`
# remote, so `git diff upstream/main` keeps showing our whole fork delta.
# Ignored here so staging in this repo cannot turn it into a stray gitlink.
adi-vst/vital/

# CMake build tree for the headless VST3 validator (JUCE compiles in here).
adi-vst/tools/validator/build/

# DAW installers and sound banks parked next to the project for testing.
# Multi-GB vendor binaries; never belongs in the repo.
adi-vst/Reason_*/
adi-vst/Reason_*.zip
adi-vst/*.exe

# adi_daw external code. Each of these is its own git repo, cloned for building
# against (third_party) or for reading (reference). Ignored here so a `git add -A`
# cannot turn one into a stray gitlink -- the same arrangement adi-vst uses for its Vital fork.
#
# reference/ is GPL code we read and NEVER copy from without attribution, and it
# is never on the include path. See adi_daw/reference/README.md.
adi_daw/third_party/
adi_daw/reference/

# CMake build tree for adi_tool / adi_core. Regenerated by tools/build.sh.
adi_daw/build/
adi_daw/build-*/

# Python bytecode. A .pyc from adi_daw/tools was committed once by a
# py_compile syntax check; it is generated, platform- and version-specific.
__pycache__/
*.pyc
